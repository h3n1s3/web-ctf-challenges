<%- include('partials/header', { title: 'Signing Secret', user: user }) %>

<%
const roleLabel = user.role === 'admin'
  ? 'LỐP PHÓ'
  : (user.role === 'superadmin' ? 'LỐP TRƯỞNG' : user.role);
%>

<div class="card">
  <h1>Crush cho bạn secret này, bạn cần làm gì đó...</h1>
  <p>Vai trò hiện tại: <span class="role-badge"><%= roleLabel %></span></p>
  <code class="secret"><%= secret %></code>
  <p>FROM CRUSH <3 </p>
  <p><a href="/admin/dashboard">← Quay lại dashboard</a></p>
</div>

<%- include('partials/footer') %>
