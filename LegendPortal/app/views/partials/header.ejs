<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title || "Nơi tình yêu bắt đầu" %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Playfair+Display:wght@500;700&family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --paper: #fff4fa;
            --paper-strong: #fff8fc;
            --ink: #473043;
            --ink-soft: #7d6077;
            --rose: #d8579d;
            --rose-soft: #ee7db8;
            --rose-deep: #a43f77;
            --line: rgba(190, 88, 146, 0.24);
            --glass: rgba(255, 245, 251, 0.86);
            --shadow: 0 14px 36px rgba(146, 70, 112, 0.2);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;

            font-family: "Quicksand", sans-serif;

            color: var(--ink);

            background:
                linear-gradient(160deg, rgba(255, 235, 247, 0.92), rgba(255, 247, 240, 0.9)),
                url("https://images.unsplash.com/photo-1522673607200-164d1b6ce486?auto=format&fit=crop&w=1600&q=80") center/cover fixed;

            min-height: 100vh;

            position: relative;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            background:
                radial-gradient(circle at 10% 15%, rgba(255, 201, 227, 0.42), transparent 40%),
                radial-gradient(circle at 85% 20%, rgba(254, 188, 214, 0.35), transparent 38%),
                radial-gradient(circle at 50% 100%, rgba(255, 219, 196, 0.34), transparent 42%);
            z-index: -2;
        }

        body::after {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            opacity: 0.18;
            background-image:
                linear-gradient(45deg, rgba(218, 120, 168, 0.45) 1px, transparent 1px),
                linear-gradient(-45deg, rgba(245, 172, 204, 0.35) 1px, transparent 1px);
            background-size: 24px 24px;
            mask-image: radial-gradient(circle at center, black 20%, transparent 85%);
            z-index: -1;
        }

        nav {
            width: min(1160px, calc(100% - 24px));
            margin: 18px auto 0;
            background: var(--glass);
            border: 1px solid var(--line);
            border-radius: 16px;
            color: var(--ink);
            padding: 14px 20px;

            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            backdrop-filter: blur(4px);
            box-shadow: var(--shadow);

            animation: slideInDown 0.9s cubic-bezier(0.22, 1, 0.36, 1);
        }

        nav a {
            color: var(--ink);

            text-decoration: none;

            margin-left: 16px;
            position: relative;
            font-size: 15px;
            letter-spacing: 0.02em;
            font-weight: 700;
        }

        nav a::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: -3px;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, var(--rose), #f08ebf);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s ease;
        }

        nav a:hover::after {
            transform: scaleX(1);
        }

        .brand {
            font-family: "Playfair Display", serif;
            font-weight: 700;
            font-size: 26px;
            letter-spacing: 0.04em;
        }

        .container {
            max-width: 1080px;
            margin: 28px auto 46px;
            padding: 0 20px;
        }

        .card {
            background: linear-gradient(145deg, rgba(255, 251, 255, 0.9), rgba(255, 236, 246, 0.88));
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 18px;
            box-shadow: var(--shadow);
            position: relative;
            overflow: hidden;
        }

        .card::before,
        .card::after {
            content: "";
            position: absolute;
            width: 110px;
            height: 110px;
            border: 1px solid rgba(216, 87, 157, 0.34);
            opacity: 0.5;
            pointer-events: none;
        }

        .card::before {
            top: -55px;
            left: -55px;
            border-right: none;
            border-bottom: none;
            border-radius: 0 0 80% 0;
        }

        .card::after {
            right: -55px;
            bottom: -55px;
            border-left: none;
            border-top: none;
            border-radius: 80% 0 0 0;
        }

        h1,
        h2,
        h3 {
            font-family: "Playfair Display", serif;
            margin-top: 0;
            color: #5b2f51;
            letter-spacing: 0.02em;
        }

        input,
        textarea {
            width: 100%;
            padding: 12px;
            margin-top: 6px;
            margin-bottom: 18px;
            border: 1px solid rgba(216, 87, 157, 0.33);
            border-radius: 10px;
            background: rgba(255, 254, 255, 0.84);
            color: var(--ink);
            transition: border-color 0.25s ease, box-shadow 0.25s ease;
        }

        input:focus,
        textarea:focus {
            outline: none;
            border-color: var(--rose-soft);
            box-shadow: 0 0 0 4px rgba(238, 125, 184, 0.2);
        }

        textarea {
            min-height: 200px;
            resize: vertical;
        }

        button {
            background: linear-gradient(120deg, var(--rose), var(--rose-deep));
            color: #fff;
            border: none;
            padding: 10px 18px;
            border-radius: 999px;
            cursor: pointer;
            font-family: "Quicksand", sans-serif;
            letter-spacing: 0.04em;
            font-weight: 700;
            transition: transform 0.25s ease, filter 0.25s ease;
        }

        button:hover {
            transform: translateY(-1px);
            filter: brightness(1.06);
        }

        .error {
            color: #7a1824;
            background: rgba(255, 225, 228, 0.75);
            padding: 12px;
            border: 1px solid rgba(175, 52, 71, 0.3);
            border-radius: 10px;
            margin-bottom: 18px;
        }

        .success {
            color: #7c285f;
            background: rgba(255, 223, 241, 0.78);
            padding: 12px;
            border: 1px solid rgba(198, 83, 146, 0.32);
            border-radius: 10px;
            margin-bottom: 18px;
        }

        .meta {
            color: var(--ink-soft);
            font-size: 14px;
        }

        .post-content {
            margin-top: 20px;
            line-height: 1.6;
        }

        .post-title a {
            color: #7b2f5f;
            text-decoration: none;
        }

        .post-title a:hover {
            text-decoration: underline;
        }

        .role-badge {
            display: inline-block;
            margin-left: 8px;
            padding: 3px 8px;
            border-radius: 999px;
            background: linear-gradient(110deg, rgba(216, 87, 157, 0.2), rgba(240, 142, 191, 0.2));
            color: #6c2e57;
            font-size: 12px;
            text-transform: uppercase;
            border: 1px solid rgba(216, 87, 157, 0.36);
            font-weight: 700;
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 18px;
        }

        .dashboard-card {
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 20px;
            background: linear-gradient(145deg, rgba(255, 250, 255, 0.9), rgba(255, 233, 245, 0.82));
            transition: transform 0.28s ease, box-shadow 0.28s ease;
        }

        .dashboard-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 32px rgba(173, 81, 128, 0.2);
        }

        .dashboard-card a {
            display: inline-block;
            margin-top: 10px;
            color: #8a2f66;
            font-weight: bold;
        }

        .unlock-card {
            position: relative;
        }

        .unlock-icon {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: rgba(255, 196, 227, 0.46);
            color: #8a2f66;
            font-size: 19px;
            border: 1px solid rgba(216, 87, 157, 0.34);
            margin-bottom: 10px;
            transition: transform 0.3s ease;
        }

        .unlock-card.unlocked .unlock-icon {
            transform: rotate(-18deg) scale(1.08);
        }

        .lock-state {
            font-size: 12px;
            color: #8d5a76;
            margin-top: 8px;
            font-weight: 600;
        }

        .vault-value {
            font-family: "Caveat", cursive;
            font-size: 30px;
            letter-spacing: 0.04em;
            color: #7b2f5f;
            margin: 8px 0 0;
        }

        .card-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px;
            margin-top: 16px;
        }

        .card-actions form {
            margin: 0;
        }

        .card-actions a {
            color: #8a2f66;
            font-weight: bold;
            text-decoration: none;
        }

        .card-actions a:hover {
            text-decoration: underline;
        }

        code.secret {
            display: block;
            overflow-wrap: anywhere;
            padding: 16px;
            background: #fff4fb;
            color: #8a2f66;
            border-radius: 10px;
            border: 1px dashed rgba(216, 87, 157, 0.4);
            font-family: "Caveat", cursive;
            font-size: 30px;
        }

        .hero {
            position: relative;
            min-height: 290px;
            border-radius: 18px;
            border: 1px solid var(--line);
            overflow: hidden;
            margin-bottom: 18px;
            box-shadow: var(--shadow);
        }

        .hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(120deg, rgba(164, 63, 119, 0.5), rgba(216, 87, 157, 0.32), rgba(247, 171, 205, 0.24));
            z-index: 2;
        }

        .hero-slide {
            position: absolute;
            inset: 0;
            opacity: 0;
            transform: scale(1.05);
            transition: opacity 0.9s ease, transform 1.2s ease;
            background-size: cover;
            background-position: center;
        }

        .hero-slide.active {
            opacity: 1;
            transform: scale(1);
        }

        .hero-content {
            position: relative;
            z-index: 3;
            height: 100%;
            padding: 34px;
            display: grid;
            align-content: end;
            gap: 8px;
            color: #fff7fb;
            text-shadow: 0 3px 15px rgba(0, 0, 0, 0.38);
        }

        .hero-content h1 {
            color: #fff3fb;
            font-size: clamp(28px, 4.2vw, 40px);
            margin-bottom: 2px;
        }

        .hero-content p {
            max-width: 640px;
            margin: 0;
            font-size: 16px;
            line-height: 1.6;
        }

        .hero-dots {
            display: flex;
            gap: 8px;
            margin-top: 16px;
        }

        .hero-dot {
            width: 9px;
            height: 9px;
            padding: 0;
            border-radius: 50%;
            background: rgba(255, 219, 238, 0.58);
            border: 1px solid rgba(255, 236, 246, 0.72);
            transition: transform 0.2s ease, background 0.2s ease;
            cursor: pointer;
        }

        .hero-dot.active {
            transform: scale(1.35);
            background: rgba(255, 244, 250, 0.95);
        }

        .reveal {
            opacity: 0;
            transform: translateY(22px);
            transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        .reveal.revealed {
            opacity: 1;
            transform: translateY(0);
        }

        @keyframes slideInDown {
            from {
                opacity: 0;
                transform: translateY(-14px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 760px) {
            nav {
                flex-direction: column;
                align-items: flex-start;
                padding: 12px 14px;
            }

            nav a {
                margin-left: 0;
                margin-right: 14px;
                display: inline-block;
                margin-top: 8px;
            }

            .container {
                padding: 0 14px;
            }

            .hero {
                min-height: 320px;
            }

            .hero-content {
                padding: 22px;
            }
        }
    </style>
</head>

<body>

<%
const roleLabel = typeof user !== "undefined" && user
    ? (user.role === "admin"
        ? "LỐP PHÓ"
        : (user.role === "superadmin" ? "LỐP TRƯỞNG" : user.role))
    : null;
%>

<nav>

    <div>
        <a
            class="brand"
            href="/"
        >
            Love Story
        </a>
    </div>

    <div>

        <% if (typeof user !== "undefined" && user) { %>

            <% if (user.role === "admin" || user.role === "superadmin") { %>
                <a href="/admin/dashboard">
                    Dashboard
                </a>
            <% } %>

            <a href="/posts/create">
                Viết lưu bút
            </a>

            <span class="role-badge"><%= roleLabel %></span>

            <a href="/logout">
                Đăng xuất
            </a>

        <% } else { %>

            <a href="/login">
                Đăng nhập
            </a>

            <a href="/register">
                Đăng ký
            </a>

        <% } %>

    </div>

</nav>

<div class="container">
