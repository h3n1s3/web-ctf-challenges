</div>

<footer class="site-footer">
	<div class="site-footer-inner">
		<p>Love Story - lưu bút của một kẻ si tình</p>
	</div>
</footer>

<style>
	.site-footer {
		width: min(1160px, calc(100% - 24px));
		margin: 0 auto 24px;
		border: 1px solid rgba(216, 87, 157, 0.28);
		border-radius: 14px;
		background: rgba(255, 245, 251, 0.76);
		box-shadow: 0 10px 28px rgba(146, 70, 112, 0.14);
		backdrop-filter: blur(4px);
	}

	.site-footer-inner {
		text-align: center;
		padding: 14px;
		color: #7c5071;
		letter-spacing: 0.05em;
		font-size: 13px;
	}
</style>

<script>
	(() => {
		const revealTargets = Array.from(document.querySelectorAll('.card, .hero, .dashboard-card, .success, .error'));
		revealTargets.forEach((element, index) => {
			element.classList.add('reveal');
			element.style.transitionDelay = `${Math.min(index * 70, 420)}ms`;
		});

		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('revealed');
					observer.unobserve(entry.target);
				}
			});
		}, { threshold: 0.12 });

		revealTargets.forEach((element) => observer.observe(element));

		const slides = Array.from(document.querySelectorAll('[data-hero-slide]'));
		const dots = Array.from(document.querySelectorAll('[data-hero-dot]'));
		const unlockLinks = Array.from(document.querySelectorAll('[data-unlock-link]'));

		unlockLinks.forEach((link) => {
			link.addEventListener('click', (event) => {
				event.preventDefault();
				const card = link.closest('.unlock-card');
				if (!card) {
					window.location.href = link.getAttribute('href');
					return;
				}

				card.classList.add('unlocked');
				const icon = card.querySelector('.unlock-icon');
				const state = card.querySelector('.lock-state');
				if (icon) icon.textContent = '🔓';
				if (state) state.textContent = 'Đã mở khóa';

				setTimeout(() => {
					window.location.href = link.getAttribute('href');
				}, 420);
			});
		});

		if (!slides.length) return;

		let current = 0;

		function activate(index) {
			slides.forEach((slide, slideIndex) => {
				slide.classList.toggle('active', slideIndex === index);
			});
			dots.forEach((dot, dotIndex) => {
				dot.classList.toggle('active', dotIndex === index);
			});
		}

		function next() {
			current = (current + 1) % slides.length;
			activate(current);
		}

		dots.forEach((dot, index) => {
			dot.addEventListener('click', () => {
				current = index;
				activate(current);
			});
		});

		activate(0);
		setInterval(next, 4200);
	})();
</script>

</body>

</html>